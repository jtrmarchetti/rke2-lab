# Secrets for the dev.lo RKE2 lab.
#
# Copy to ~/.config/rke2lab/env.sh, fill in the values, and chmod 0600:
#
#   install -d -m 0700 ~/.config/rke2lab
#   install -m 0600 bootstrap/env.sh.example ~/.config/rke2lab/env.sh
#   ${EDITOR:-vi} ~/.config/rke2lab/env.sh
#
# Then, once per shell, before running any automation:
#
#   source ~/.config/rke2lab/env.sh
#
# This file is a TEMPLATE. It contains no values and must never contain any —
# plan/SECRETS.md's first rule is that no secret lives in this repository. It
# exists because the rule left a gap: the names were recorded in prose, so a
# controller rebuilt from a fresh clone knew that secrets were needed but not
# which ones. Every playbook's preflight check asserts against these names.
#
# QUOTE WITH SINGLE QUOTES. The superseded file used double quotes, and a
# password containing `$Fls3` was expanded as an undefined shell variable and
# silently truncated. Single quotes prevent $, ` and \ from being interpreted.
#
# Values marked WRITTEN BY AUTOMATION are recorded here by a role after it
# generates them. Leave them empty on a first build; they are in this template
# so that a restored file is complete and a rebuilt one is not surprising.

# --- Proxmox and Pulumi ----------------------------------------------------
#
# The hypervisor API credentials Pulumi builds every VM with, and the
# passphrase that decrypts the stack configuration in Pulumi.dev.yaml.
#
# PROXMOX_VE_PASSWORD and the stack's own encrypted proxmox:password have
# drifted apart before. `pulumi config get proxmox:password` is the value that
# actually authenticates; keep the two the same.
export PROXMOX_VE_ENDPOINT=''
export PROXMOX_VE_USERNAME=''
export PROXMOX_VE_PASSWORD=''
export PROXMOX_VE_INSECURE='true'
export PULUMI_CONFIG_PASSPHRASE=''

# --- Guest access ----------------------------------------------------------
#
# Injected by cloud-init into every VM Pulumi creates, and then used by Ansible
# to connect to them. The public key is not secret; it lives here so that one
# file describes the whole login path.
export VM_USERNAME=''
export VM_USER_PASSWORD=''
export VM_SSH_PUBLIC_KEY=''

# --- The controller tunnel -------------------------------------------------
#
# Private keys only. Each end's PUBLIC key is in group_vars and is committed
# deliberately — a public key is not a secret, and keeping it in inventory is
# what lets one playbook configure both ends.
#
# Both of these existed in git history in plaintext once and should be treated
# as exposed until rotated; see the rotation procedure in plan/SECRETS.md.
export WIREGUARD_CONTROLLER_PRIVATE_KEY=''
export WIREGUARD_REPO_PRIVATE_KEY=''

# --- Identity (FreeIPA on core01) ------------------------------------------
#
# The directory manager password is the one that cannot be reset without a
# reinstall of the domain. The admin password signs certificates in later
# phases as well as administering the domain.
export FREEIPA_ADMIN_PASSWORD=''
export FREEIPA_DIR_MANAGER_PASSWORD=''

# --- GitLab (repo01) -------------------------------------------------------
#
# The root password administers GitLab and is what the publishing roles use to
# create groups, projects, and deploy tokens through the API.
export GITLAB_ROOT_PASSWORD=''

# Optional. Set both to make the publishing roles use a deploy token you issued
# by hand; leave empty and rke2_publish mints one and records it on repo01 at
# /data1/gitlab/rke2-deploy-token.yml.
export GITLAB_REGISTRY_USER=''
export GITLAB_REGISTRY_TOKEN=''

# --- The cluster -----------------------------------------------------------
#
# One shared join secret, identical on servers and workers. A node holding a
# different value is rejected at registration.
export RKE2_TOKEN=''

# --- Cluster services ------------------------------------------------------
#
# Authored, not generated: each of these names something a service's own
# configuration refers to, so it has to exist before the service does. The
# openbao_secrets role writes them into the vault, and the workload reads them
# back through an ExternalSecret. They were sealed into the cluster-state
# repository until 2026-08-16; see plan/SECRETS.md for what still is.
export KEYCLOAK_ADMIN_PASSWORD=''
export KEYCLOAK_DB_PASSWORD=''
export GRAFANA_ADMIN_PASSWORD=''
export GARAGE_ADMIN_TOKEN=''
export GARAGE_METRICS_TOKEN=''
export GARAGE_RPC_SECRET=''

# --- Single sign-on --------------------------------------------------------
#
# One OIDC client secret per federated service. Authored here rather than
# generated by Keycloak, and that is the whole answer to the ordering problem
# single sign-on would otherwise create.
#
# If Keycloak minted these, then every service that reads its secret from the
# vault could not be configured until Keycloak was running — and Keycloak is
# deployed by Flux from a repository GitLab serves, so on a cold rebuild the
# dependents come up first. Authoring them means the value exists before either
# end does: openbao_secrets writes it into the vault on the first pass, the
# workloads start holding a credential for a client that does not exist yet,
# and keycloak_clients sets that same value on the client whenever Keycloak is
# reachable. Neither end waits for the other. It is the same argument
# GARAGE_RPC_SECRET already carries above.
#
# Any long random string will do. `openssl rand -hex 32` for each; they must
# differ from one another, because they are four separate client credentials.
export OIDC_CLIENT_SECRET_GRAFANA=''
export OIDC_CLIENT_SECRET_LONGHORN=''
export OIDC_CLIENT_SECRET_OPENBAO=''
export OIDC_CLIENT_SECRET_GITLAB=''

# Not an OIDC credential. This is the key the oauth2-proxy in front of the
# Longhorn UI encrypts its own session cookie with, so rotating it signs
# everyone out and does nothing else.
#
# EXACTLY 16, 24 or 32 bytes. oauth2-proxy refuses to start on any other
# length, reporting an AES key size error that never mentions cookies, so the
# openbao_secrets role checks it here instead. Generate with:
#
#   openssl rand -base64 32 | head -c 32
export OAUTH2_PROXY_COOKIE_SECRET=''

# --- WRITTEN BY AUTOMATION -------------------------------------------------
#
# Leave empty on a cold build. The roles named below generate these and write
# them back here; they are listed so that a restored env.sh is recognisably
# complete and an empty one is not mistaken for a missing step.

# Written by garage_init after the object store first starts. Copied into the
# vault by openbao_secrets on the NEXT run — a playbook reads the environment
# it started with, so the run that mints these cannot also store them.
export GARAGE_S3_ACCESS_KEY=''
export GARAGE_S3_SECRET_KEY=''

# Written by openbao_init when the vault is first initialised. This is the
# OFFLINE BREAK-GLASS COPY: the automation's copy is a SealedSecret in Git,
# which is useless if the Sealed Secrets sealing key is lost. This copy is what
# recovers the vault when that happens. Five shares; three meet the threshold.
export OPENBAO_UNSEAL_KEYS=''
export OPENBAO_ROOT_TOKEN=''

# --- Files that are not variables ------------------------------------------
#
# Three things live beside this file rather than in it, because they are keys
# and objects rather than values. A restore that brings back only env.sh gets
# as far as the GitOps push and stops. See plan/SECRETS.md.
#
#   ~/.config/rke2lab/sealed-secrets-key.yaml   mode 0600
#       Every SealedSecret in the cluster-state repository is sealed against
#       it. Restored into the cluster by gitops_bootstrap before Flux installs
#       a controller that would otherwise generate its own.
#
#   ~/.config/rke2lab/k8s-ca/                   mode 0700
#       The cluster's intermediate CA. ipa_sub_ca regenerates it if absent,
#       which re-issues every certificate in the cluster. Restoring is cheaper.
#
#   ~/.config/rke2lab/flux-deploy-token.yml     mode 0600
#       Flux's read-only deploy token. Recreated by gitops_bootstrap if the
#       file is gone, so this one is a convenience rather than a loss.
