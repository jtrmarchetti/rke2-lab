{{ ansible_managed | comment }}
# Read by the container at start. Kept out of the compose file so the compose
# file can stay 0640 and readable during review while this one is 0600.
#
# GITLAB_ROOT_PASSWORD seeds the root account on the first reconfigure only.
# Once the database exists it is ignored, and changing the password is a
# GitLab-side operation rather than an inventory change.
GITLAB_ROOT_PASSWORD={{ gitlab_root_password }}
