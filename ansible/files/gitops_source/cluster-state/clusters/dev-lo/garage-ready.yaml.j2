{{ ansible_managed | comment }}

---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: garage-ready
  namespace: flux-system
spec:
  interval: 30m
  retryInterval: 2m
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
  path: ./garage-ready
  healthChecks:

    - apiVersion: v1
      kind: ConfigMap
      name: garage-buckets-ready
      namespace: garage
