{{ ansible_managed | comment }}
# The two objects that point Flux at this repository, and the reason this file
# no longer says "generated by flux. DO NOT EDIT".
#
# `flux bootstrap` writes this pair and then commits them here, which makes the
# CLI the author of the one file the whole reconcile hangs from — and makes its
# content depend on which CLI version happened to be installed. Ansible owns it
# instead: `gitops_bootstrap` applies this file and the vendored component set
# once, and Flux self-manages from Git afterwards, exactly as it would have
# after a bootstrap. `PHASE6_IMPLEMENTATION.md` names this as the supported
# path; it is now the only path.
#
# The Secret named below is not in this repository and must not be: it holds the
# token Flux reads this repository with, and the CA that signs its certificate.
# `gitops_bootstrap` creates it in the cluster.
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 1m0s
  ref:
    branch: {{ gitops_source_branch }}
  secretRef:
    name: flux-system
  url: {{ _var_gitops_source_git_url | trim }}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 10m0s
  path: {{ gitops_source_cluster_path }}
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
