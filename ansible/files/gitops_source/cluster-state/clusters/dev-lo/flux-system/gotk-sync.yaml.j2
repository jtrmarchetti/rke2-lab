{{ ansible_managed | comment }}







---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 1m0s
  ref:
    branch: {{ gitops_source_branch }}
  secretRef:
    name: flux-system
  url: {{ _var_gitops_source_git_url | trim }}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 10m0s
  path: {{ gitops_source_cluster_path }}
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
