{{ ansible_managed | comment }}
# The Longhorn proxy's OIDC client secret and its cookie key, out of OpenBao.
#
# Both are authored in the controller's env.sh and written into the vault by
# the openbao_secrets role, rather than generated by Keycloak and read back.
# That is what lets this Deployment start on a cold rebuild: the vault entry is
# written on the first pass, before Keycloak has ever run, so the Secret syncs
# and the pod comes up holding a credential for a client that does not exist
# yet. It begins working the moment keycloak_clients creates that client — no
# restart, no second pass, and nothing here waiting on anything.
#
# The cookie secret is not an OIDC credential. It is the key oauth2-proxy
# encrypts its own session cookie with; rotating it signs everyone out and does
# nothing else. It must be 16, 24 or 32 bytes, which openbao_secrets asserts —
# any other length is refused at start-up with an AES key size error that never
# mentions cookies.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: longhorn-auth
  namespace: longhorn-system
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao
    kind: ClusterSecretStore
  target:
    name: longhorn-auth
  data:
    - secretKey: client-secret
      remoteRef:
        key: oidc-longhorn
        property: client-secret
    - secretKey: cookie-secret
      remoteRef:
        key: oidc-longhorn
        property: cookie-secret
