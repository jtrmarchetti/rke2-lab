{{ ansible_managed | comment }}
---
apiVersion: v1
kind: Secret
metadata:
  name: longhorn-auth-ca
  namespace: longhorn-system
data:
  ca.crt: >-
    {{ lookup('file', inventory_gitops_source_domain_ca_file, rstrip=false) | b64encode }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: longhorn-auth
  namespace: longhorn-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: longhorn-auth
  template:
    metadata:
      labels:
        app: longhorn-auth
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      containers:
        - name: oauth2-proxy
          image: quay.io/oauth2-proxy/oauth2-proxy:v7.15.4
          imagePullPolicy: IfNotPresent
          args:
            - --provider=keycloak-oidc
            - --oidc-issuer-url=https://sso.{{ inventory_gitops_source_cluster_domain }}/realms/{{ inventory_gitops_source_keycloak_realm }}
            - --client-id=longhorn
            - --provider-ca-file=/etc/ssl/domain/ca.crt
            - --redirect-url=https://longhorn.{{ inventory_gitops_source_cluster_domain }}/oauth2/callback
            - --upstream=http://longhorn-frontend.longhorn-system.svc.cluster.local:80
            - --allowed-role=longhorn:admin
            - --allowed-role=longhorn:user
            - --http-address=0.0.0.0:4180
            - --reverse-proxy=true
            - --cookie-secure=true
            - --cookie-samesite=lax
            - --cookie-expire=1h
            - --cookie-refresh=15m
            - --email-domain=*
            - --skip-provider-button=true
            - --set-xauthrequest=true
            - --pass-basic-auth=false
            - --pass-user-headers=true
          env:
            - name: OAUTH2_PROXY_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: longhorn-auth
                  key: client-secret
            - name: OAUTH2_PROXY_COOKIE_SECRET
              valueFrom:
                secretKeyRef:
                  name: longhorn-auth
                  key: cookie-secret
          ports:
            - containerPort: 4180
              name: http
          volumeMounts:
            - name: domain-ca
              mountPath: /etc/ssl/domain
              readOnly: true
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 96Mi
          readinessProbe:
            httpGet:
              path: /ping
              port: 4180
            periodSeconds: 15
          livenessProbe:
            httpGet:
              path: /ping
              port: 4180
            initialDelaySeconds: 30
            periodSeconds: 30
      volumes:
        - name: domain-ca
          secret:
            secretName: longhorn-auth-ca
---
apiVersion: v1
kind: Service
metadata:
  name: longhorn-auth
  namespace: longhorn-system
spec:
  type: ClusterIP
  selector:
    app: longhorn-auth
  ports:
    - port: 80
      targetPort: 4180
      name: http
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: longhorn-auth
  namespace: longhorn-system
  annotations:
    cert-manager.io/cluster-issuer: k8s-ca
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - longhorn.{{ inventory_gitops_source_cluster_domain }}
      secretName: longhorn-ui-tls
  rules:
    - host: longhorn.{{ inventory_gitops_source_cluster_domain }}
      http:
        paths:

          - path: /
            pathType: Prefix
            backend:
              service:
                name: longhorn-auth
                port:
                  number: 80
