{{ ansible_managed | comment }}
# Garage's cluster and control-plane credentials, out of OpenBao.
#
# Previously a SealedSecret; see apps/keycloak/secrets.yaml for why every
# runtime secret moved to the vault and which three did not.
#
# Read from `garage-cluster` rather than from `garage`, and the split is
# deliberate: these three are authored by hand and are what Garage needs in
# order to start, while `garage` holds the S3 access key Garage itself mints
# once it has started. Two origins and two lifecycles, so two entries — one
# path with two writers would mean whichever wrote last dropped the other's
# keys.
#
# rpc-secret is what the nodes authenticate to each other with, so changing it
# is a cluster-wide event rather than a credential rotation: every node must be
# restarted onto the new value together. ESO's refresh will propagate a new
# value into the Secret on its own; it will not restart the pods that hold the
# old one.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: garage-secrets
  namespace: garage
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao
    kind: ClusterSecretStore
  target:
    name: garage-secrets
  data:
    - secretKey: admin-token
      remoteRef:
        key: garage-cluster
        property: admin-token
    - secretKey: metrics-token
      remoteRef:
        key: garage-cluster
        property: metrics-token
    - secretKey: rpc-secret
      remoteRef:
        key: garage-cluster
        property: rpc-secret
