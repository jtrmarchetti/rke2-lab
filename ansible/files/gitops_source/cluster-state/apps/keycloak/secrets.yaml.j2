{{ ansible_managed | comment }}









---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: keycloak-secrets
  namespace: keycloak
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao
    kind: ClusterSecretStore
  target:
    name: keycloak-secrets
  data:
    - secretKey: admin-password
      remoteRef:
        key: keycloak
        property: admin-password
    - secretKey: db-password
      remoteRef:
        key: keycloak
        property: db-password
