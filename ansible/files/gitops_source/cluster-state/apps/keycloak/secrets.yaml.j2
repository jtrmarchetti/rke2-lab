{{ ansible_managed | comment }}
# Keycloak's bootstrap administrator and its database password, out of OpenBao.
#
# This file used to be a SealedSecret produced by kubeseal at play time. It is
# an ExternalSecret now because sealing was doing a job the vault does better:
# a SealedSecret is a value frozen into a Git commit, decryptable only by one
# controller's key, with no versions, no rotation and no audit of who read it.
# The vault has all four, and ESO authenticates to it with a ServiceAccount
# token rather than a stored credential.
#
# What stays sealed is the material that genuinely predates the vault — the
# registry pull credential, the cluster's CA key pair, and the vault's own
# unseal keys. Nothing else needs to.
#
# The database password is the one value here that is not free to change:
# rotating it in the vault without rotating it in the database leaves Keycloak
# unable to start, and the failure reads as a broken PVC rather than a wrong
# password.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: keycloak-secrets
  namespace: keycloak
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao
    kind: ClusterSecretStore
  target:
    name: keycloak-secrets
  data:
    - secretKey: admin-password
      remoteRef:
        key: keycloak
        property: admin-password
    - secretKey: db-password
      remoteRef:
        key: keycloak
        property: db-password
