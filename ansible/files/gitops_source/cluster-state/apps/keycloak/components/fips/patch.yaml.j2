{{ ansible_managed | comment }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keycloak
spec:
  template:
    spec:
      containers:
        - name: keycloak
          args:
            - start
            - --optimized=false
            - --features=fips
          env:
            - name: KC_FIPS_MODE
              value: strict
