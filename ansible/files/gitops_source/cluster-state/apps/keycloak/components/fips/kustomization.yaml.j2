{{ ansible_managed | comment }}
# FIPS mode for Keycloak, as a component an environment opts into.
#
# Enable it from the cluster's own kustomization:
#
#     components:
#       - ../../apps/keycloak/components/fips
#
# It is not enabled in dev-lo. Dev is not inside the FIPS boundary and there is
# nothing to gain from pretending otherwise: FIPS mode narrows the algorithms
# available, which is a constraint worth carrying where it is required and pure
# friction where it is not.
#
# Two settings, and needing both is the trap. `KC_FIPS_MODE=strict` alone fails
# at build time with:
#
#     ERROR: FIPS mode cannot be enabled without enabling the FIPS feature
#            --features=fips
#
# — a message that names the fix, after a Java stack trace long enough to bury
# it. The feature flag loads the BouncyCastle FIPS provider; the mode decides
# how strictly it is enforced. Setting the mode without the feature asks for
# enforcement of something that was never loaded.
#
# `strict` rather than `non-strict`, because a boundary that permits the
# algorithms it exists to exclude is not a boundary. It has consequences worth
# knowing before production meets them: the admin password must satisfy the
# minimum length FIPS requires, any keystore Keycloak reads has to be BCFKS,
# and password hashing moves to PBKDF2 variants inside the validated set —
# which means hashes created outside FIPS mode may not verify inside it.
---
apiVersion: kustomize.config.k8s.io/v1alpha1
kind: Component
patches:
  - path: patch.yaml
    target:
      kind: Deployment
      name: keycloak
