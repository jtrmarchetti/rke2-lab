{{ ansible_managed | comment }}
---
# Hubble UI on the platform Gateway's hubble listener. The listener's
# TLS is terminated at the edge (the cert-manager shim issues
# hubble-edge-tls for it, the same way as every other edge host); the
# UI pod itself stays plain HTTP inside the encrypted pod network.
# The backend is the hubble-ui Service the rke2-cilium chart creates in
# kube-system (port 80 -> nginx 8081), so the route lives here, in
# kube-system, next to its backend.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hubble-ui
  namespace: kube-system
spec:
  parentRefs:
    - name: platform
      namespace: kube-system
      sectionName: hubble
  hostnames:
    - hubble.{{ inventory_gitops_source_cluster_domain }}
  rules:
    - backendRefs:
        - name: hubble-ui
          port: 80
