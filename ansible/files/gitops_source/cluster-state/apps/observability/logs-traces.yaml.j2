{{ ansible_managed | comment }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: garage-s3
  namespace: observability
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao
    kind: ClusterSecretStore
  target:
    name: garage-s3
  data:
    - secretKey: access_key
      remoteRef:
        key: garage
        property: access_key
    - secretKey: secret_key
      remoteRef:
        key: garage
        property: secret_key
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: loki
  namespace: observability
spec:
  interval: 30m
  timeout: 15m
  driftDetection:
    mode: warn
  dependsOn:
    - name: kube-prometheus-stack
  chart:
    spec:
      chart: loki
      version: 7.3.0
      sourceRef:
        kind: HelmRepository
        name: gitlab-charts
        namespace: flux-system
  install:
    remediation:
      retries: 2
  upgrade:
    remediation:
      retries: 2
  values:
    deploymentMode: SingleBinary
    loki:
      image:
        tag: 3.6.12
      auth_enabled: false
      commonConfig:
        replication_factor: 1
      schemaConfig:
        configs:
          - from: "2026-01-01"
            store: tsdb
            object_store: s3
            schema: v13
            index:
              prefix: index_
              period: 24h
      storage:
        type: s3
        bucketNames:
          chunks: loki
          ruler: loki
        s3:
          endpoint: http://garage.garage.svc.cluster.local:3900
          region: dev-lo
          s3ForcePathStyle: true
          insecure: true
      limits_config:
        retention_period: 168h
        ingestion_rate_mb: 8
        ingestion_burst_size_mb: 16
      compactor:
        working_directory: /var/loki/compactor
        retention_enabled: true
        delete_request_store: s3
    singleBinary:
      replicas: 1
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      extraEnv:
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: garage-s3
              key: access_key
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: garage-s3
              key: secret_key
      resources:
        requests:
          cpu: 100m
          memory: 384Mi
        limits:
          memory: 1Gi
      persistence:
        enabled: true
        storageClass: longhorn
        size: 5Gi
    read:
      replicas: 0
    write:
      replicas: 0
    backend:
      replicas: 0
    chunksCache:
      enabled: false
    resultsCache:
      enabled: false
    lokiCanary:
      enabled: false
    test:
      enabled: false
    gateway:
      enabled: false
    sidecar:
      rules:
        enabled: false
---

apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: tempo
  namespace: observability
spec:
  interval: 30m
  timeout: 15m
  driftDetection:
    mode: warn
  dependsOn:
    - name: kube-prometheus-stack
  chart:
    spec:
      chart: tempo
      version: 1.24.4
      sourceRef:
        kind: HelmRepository
        name: gitlab-charts
        namespace: flux-system
  install:
    remediation:
      retries: 2
  upgrade:
    remediation:
      retries: 2
  values:
    tempo:
      extraEnv:
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: garage-s3
              key: access_key
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: garage-s3
              key: secret_key
      memBallastSizeMbs: 64
      reportingEnabled: false
      storage:
        trace:
          backend: s3
          s3:
            bucket: tempo
            endpoint: garage.garage.svc.cluster.local:3900
            region: dev-lo
            insecure: true
            forcepathstyle: true
      retention: 48h
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          memory: 512Mi
      receivers:
        otlp:
          protocols:
            grpc:
              endpoint: "0.0.0.0:4317"
            http:
              endpoint: "0.0.0.0:4318"
    tempoQuery:
      enabled: false
    persistence:
      enabled: true
      storageClassName: longhorn
      size: 2Gi
    nodeSelector:
      node-role.kubernetes.io/worker: "true"
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: alloy
  namespace: observability
spec:
  interval: 30m
  timeout: 15m
  driftDetection:
    mode: warn
  dependsOn:
    - name: loki
  chart:
    spec:
      chart: alloy
      version: 1.11.1
      sourceRef:
        kind: HelmRepository
        name: gitlab-charts
        namespace: flux-system
  install:
    remediation:
      retries: 2
  upgrade:
    remediation:
      retries: 2
  values:
    controller:
      type: daemonset
      tolerations:
        - operator: Exists
    alloy:
      extraPorts:
        - name: otlp-grpc
          port: 4317
          targetPort: 4317
          protocol: TCP
        - name: otlp-http
          port: 4318
          targetPort: 4318
          protocol: TCP
      mounts:
        varlog: true
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          memory: 320Mi
      configMap:
        content: |
          // Every pod's logs, labelled with where they came from, shipped to
          // Loki. Discovery is by the Kubernetes API rather than by reading
          // the filesystem layout, so a change in how the runtime names log
          // files does not silently stop collection.
          discovery.kubernetes "pods" {
            role = "pod"
          }

          discovery.relabel "pods" {
            targets = discovery.kubernetes.pods.targets

            rule {
              source_labels = ["__meta_kubernetes_namespace"]
              target_label  = "namespace"
            }
            rule {
              source_labels = ["__meta_kubernetes_pod_name"]
              target_label  = "pod"
            }
            rule {
              source_labels = ["__meta_kubernetes_pod_container_name"]
              target_label  = "container"
            }
            rule {
              source_labels = ["__meta_kubernetes_node_name"]
              target_label  = "node"
            }
          }

          loki.source.kubernetes "pods" {
            targets    = discovery.relabel.pods.output
            forward_to = [loki.write.default.receiver]
          }

          loki.write "default" {
            endpoint {
              url = "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push"
            }
          }

          // The OpenTelemetry half. This is why there is no second collector:
          // anything in the cluster can send OTLP here and have its traces
          // land in Tempo.
          otelcol.receiver.otlp "default" {
            grpc {
              endpoint = "0.0.0.0:4317"
            }
            http {
              endpoint = "0.0.0.0:4318"
            }
            output {
              traces = [otelcol.exporter.otlp.tempo.input]
            }
          }

          otelcol.exporter.otlp "tempo" {
            client {
              endpoint = "tempo.observability.svc.cluster.local:4317"
              tls {
                insecure = true
              }
            }
          }
