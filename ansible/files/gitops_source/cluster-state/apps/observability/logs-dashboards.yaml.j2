              "calcs": [
                "sum"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 8,
          "type": "logs",
          "title": "Error-shaped lines, cluster-wide",
          "description": "Every namespace, newest first. The entry point when something is wrong and it is not yet clear where.",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "gridPos": {
            "h": 13,
            "w": 24,
            "x": 0,
            "y": 21
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
