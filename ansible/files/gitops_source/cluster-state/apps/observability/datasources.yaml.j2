{{ ansible_managed | comment }}
# The two datasources the chart does not already provide.
#
# Prometheus is deliberately absent: kube-prometheus-stack provisions it
# itself, as the organisation's default, and it knows its own service address.
# Adding a second one here marked `isDefault` does not merge or override — it
# makes Grafana refuse to start, with "Only one datasource per organization can
# be marked as default", and Grafana refusing to start fails the whole Helm
# release. Declaring only what is missing is both smaller and correct.
#
# The sidecar watches for this label in every namespace and writes what it
# finds into Grafana's provisioning directory, so these survive Grafana being
# deleted and recreated, and arrive by commit rather than by clicking.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasources
  namespace: observability
  labels:
    grafana_datasource: "1"
data:
  loki-tempo.yaml: |
    apiVersion: 1
    datasources:
      - name: Loki
        type: loki
        access: proxy
        url: http://loki.observability.svc.cluster.local:3100
      # 3200, not 3100. Tempo's HTTP API does not share Loki's port, and a
      # datasource pointed at the wrong one reports "no data" rather than a
      # connection error, which sends you looking at the traces instead of at
      # the URL.
      - name: Tempo
        type: tempo
        access: proxy
        url: http://tempo.observability.svc.cluster.local:3200
