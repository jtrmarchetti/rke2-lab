{{ ansible_managed | comment }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: observability
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: kube-prometheus-stack
  namespace: observability
spec:
  interval: 30m
  timeout: 20m
  driftDetection:
    mode: warn
  chart:
    spec:
      chart: kube-prometheus-stack
      version: 88.5.4
      sourceRef:
        kind: HelmRepository
        name: gitlab-charts
        namespace: flux-system
  install:
    crds: Create
    remediation:
      retries: 2
  upgrade:
    crds: CreateReplace
    remediation:
      retries: 2
  values:
    crds:
      enabled: true
    thanosRuler:
      enabled: false
    windowsMonitoring:
      enabled: false
    prometheusOperator:
      admissionWebhooks:
        certManager:
          enabled: true
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      resources:
        requests:
          cpu: 25m
          memory: 96Mi
        limits:
          memory: 256Mi
      prometheusConfigReloader:
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            memory: 96Mi
    prometheus:
      prometheusSpec:
        scrapeInterval: 60s
        evaluationInterval: 60s
        retention: 5d
        retentionSize: 6GB
        nodeSelector:
          node-role.kubernetes.io/worker: "true"
        resources:
          requests:
            cpu: 200m
            memory: 512Mi
          limits:
            memory: 1536Mi
        storageSpec:
          volumeClaimTemplate:
            spec:
              storageClassName: longhorn
              accessModes: [ReadWriteOnce]
              resources:
                requests:
                  storage: 8Gi
        serviceMonitorSelectorNilUsesHelmValues: false
        podMonitorSelectorNilUsesHelmValues: false
        ruleSelectorNilUsesHelmValues: false
        probeSelectorNilUsesHelmValues: false
    kubeProxy:
      service:
        selector:
          component: kube-proxy
    alertmanager:
      alertmanagerSpec:
        nodeSelector:
          node-role.kubernetes.io/worker: "true"
        resources:
          requests:
            cpu: 10m
            memory: 64Mi
          limits:
            memory: 128Mi
        storage:
          volumeClaimTemplate:
            spec:
              storageClassName: longhorn
              accessModes: [ReadWriteOnce]
              resources:
                requests:
                  storage: 1Gi
    kube-state-metrics:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      resources:
        requests:
          cpu: 10m
          memory: 64Mi
        limits:
          memory: 192Mi
    prometheus-node-exporter:
      tolerations:
        - operator: Exists
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          memory: 64Mi
    grafana:
      enabled: true
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      persistence:
        enabled: false
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          memory: 320Mi
      imageRenderer:
        enabled: false
      sidecar:
        dashboards:
          enabled: true
          searchNamespace: ALL
        datasources:
          enabled: true
          searchNamespace: ALL
        resources:
          requests:
            cpu: 10m
            memory: 64Mi
          limits:
            memory: 128Mi
      admin:
        existingSecret: grafana-admin
        userKey: username
        passwordKey: password
      extraSecretMounts:
        - name: grafana-oidc
          secretName: grafana-oidc
          mountPath: /etc/grafana/oidc
          readOnly: true
        - name: grafana-domain-ca
          secretName: grafana-domain-ca
          mountPath: /etc/grafana/ca
          readOnly: true
      grafana.ini:
        server:
          root_url: https://grafana.{{ inventory_gitops_source_cluster_domain }}
        auth:
          # generic_oauth does not record a user_auth AuthID, so the user-sync
          # hook reconciles a known user by email only when this is set.
          # Without it, repeat SSO logins fail to resolve the existing user
          # ("user not found") and no grafana_session is established.
          oauth_allow_insecure_email_lookup: true
        auth.anonymous:
          enabled: false
        auth.generic_oauth:
          enabled: true
          name: dev.lo single sign-on
          allow_sign_up: true
          auto_login: false
          client_id: grafana
          client_secret: $__file{/etc/grafana/oidc/client-secret}
          scopes: openid profile email
          auth_url: https://sso.{{ inventory_gitops_source_cluster_domain }}/realms/{{ inventory_gitops_source_keycloak_realm }}/protocol/openid-connect/auth
          token_url: https://sso.{{ inventory_gitops_source_cluster_domain }}/realms/{{ inventory_gitops_source_keycloak_realm }}/protocol/openid-connect/token
          api_url: https://sso.{{ inventory_gitops_source_cluster_domain }}/realms/{{ inventory_gitops_source_keycloak_realm }}/protocol/openid-connect/userinfo
          signout_redirect_url: https://sso.{{ inventory_gitops_source_cluster_domain }}/realms/{{ inventory_gitops_source_keycloak_realm }}/protocol/openid-connect/logout
          tls_client_ca: /etc/grafana/ca/ca.crt
          use_pkce: true
          role_attribute_path: >-
            contains(roles[*], 'admin') && 'Admin' ||
            contains(roles[*], 'user') && 'Viewer'
          role_attribute_strict: true
          allow_assign_grafana_admin: false
      # Edge exposure of Grafana is owned by the shared platform Gateway
      # (kube-system) via a standalone HTTPRoute in this file; the chart's
      # own Ingress is disabled so TLS/hosts stay a single platform concern.
      ingress:
        enabled: false

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: grafana
  namespace: observability
spec:
  parentRefs:
    - name: platform
      namespace: kube-system
      sectionName: grafana
  hostnames:
    - grafana.{{ inventory_gitops_source_cluster_domain }}
  rules:
    - backendRefs:
        - name: kube-prometheus-stack-grafana
          port: 80
