{{ ansible_managed | comment }}
# Grafana's OIDC client secret, out of OpenBao, and the CA it verifies
# Keycloak's certificate with.
#
# The client secret is authored in the controller's env.sh and written into the
# vault by openbao_secrets, not generated by Keycloak and read back. That is
# what lets Grafana start on a cold rebuild before Keycloak exists: the vault
# entry is written on the first pass, this Secret syncs, and the pod comes up
# holding a credential for a client that does not exist yet. Sign-in begins
# working the moment keycloak_clients creates the client. See
# ansible/roles/keycloak_clients/tasks/main.yml for the whole argument.
#
# Note what this file does *not* remove. `grafana-admin` still exists beside
# it, and Grafana still accepts that password. Grafana federating to Keycloak
# means Grafana is unreachable exactly when Keycloak will not start — and the
# cluster whose metrics would explain why is this one.
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: grafana-oidc
  namespace: observability
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: openbao
    kind: ClusterSecretStore
  target:
    name: grafana-oidc
  data:
    - secretKey: client-secret
      remoteRef:
        key: oidc-grafana
        property: client-secret
---
# The domain CA. Public material, committed in the clear but read from the
# controller's trust store at render time rather than pasted, so reissuing the
# domain CA changes this file without anyone remembering to re-copy it — the
# same arrangement as the registry's CA Secret in the infrastructure layer.
#
# The domain root suffices even though sso's certificate is issued by the
# cluster's intermediate: cert-manager's CA issuer serves the intermediate
# alongside the leaf, so the chain completes here.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-domain-ca
  namespace: observability
data:
  ca.crt: >-
    {{ lookup('file', gitops_source_domain_ca_file, rstrip=false) | b64encode }}
