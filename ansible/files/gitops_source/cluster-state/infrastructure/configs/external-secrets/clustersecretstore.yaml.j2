# The store every ExternalSecret in this cluster reads from.
#
# Kubernetes auth, not a token. The operator presents the ServiceAccount token
# the API server already issues it, OpenBao validates that against the same API
# server, and the result is a short-lived vault token. There is no static
# credential in Git, in a Secret, or in anyone's environment — which is the
# reason this cluster needed Sealed Secrets for so little.
#
# `provider: vault` because OpenBao is API-compatible with Vault and the
# operator's provider is named after the API, not the implementation.
---
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: openbao
spec:
  provider:
    vault:
      server: http://openbao.openbao.svc.cluster.local:8200
      path: kv
      version: v2
      auth:
        kubernetes:
          mountPath: kubernetes
          role: external-secrets
          serviceAccountRef:
            name: external-secrets
            namespace: external-secrets
