{{ ansible_managed | comment }}








---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: openbao-unsealer
  namespace: openbao
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openbao-unsealer
  namespace: openbao
spec:
  replicas: 1
  selector:
    matchLabels:
      app: openbao-unsealer
  template:
    metadata:
      labels:
        app: openbao-unsealer
    spec:
      serviceAccountName: openbao-unsealer
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      containers:
        - name: unsealer
          image: quay.io/openbao/openbao:2.6.1
          imagePullPolicy: IfNotPresent
          env:
            - name: BAO_ADDR
              value: http://openbao.openbao.svc.cluster.local:8200
            - name: INTERVAL
              value: "15"
          command:
            - /bin/sh
            - -c
            - |


              while true; do
                bao status >/dev/null 2>&1
                rc=$?
                if [ "$rc" -eq 2 ]; then
                  echo "vault is sealed, applying key shares"
                  for f in /unseal-keys/key*; do
                    bao operator unseal "$(cat "$f")" >/dev/null 2>&1 || true
                  done
                  bao status >/dev/null 2>&1 && echo "vault unsealed"
                fi
                sleep "${INTERVAL}"
              done
          volumeMounts:
            - name: keys
              mountPath: /unseal-keys
              readOnly: true
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
      volumes:
        - name: keys
          secret:
            secretName: openbao-unseal-keys
