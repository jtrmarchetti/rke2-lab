{{ ansible_managed | comment }}
# The unsealer, which is what makes the vault survive a restart unattended.
#
# OpenBao comes up sealed after every restart — a pod eviction, a node reboot,
# a chart upgrade — and stays sealed until someone presents a threshold of key
# shares. Without this loop the cluster self-heals from Git in every respect
# except the one that holds its secrets.
#
# It is deliberately dull: the vault's own image, already mirrored, running a
# shell loop that asks for status and applies keys when the answer is "sealed".
# No new image to mirror, no operator to keep current, and nothing to
# understand when it is the thing that has broken.
#
# It has its own Flux Kustomization rather than living with the OpenBao release
# — see clusters/dev-lo/unsealer.yaml. That is not tidiness: a real auto-unseal
# seal makes this loop redundant, and retiring it should be deleting one
# declaration rather than unpicking it from the vault's own deployment.
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: openbao-unsealer
  namespace: openbao
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openbao-unsealer
  namespace: openbao
spec:
  replicas: 1
  selector:
    matchLabels:
      app: openbao-unsealer
  template:
    metadata:
      labels:
        app: openbao-unsealer
    spec:
      serviceAccountName: openbao-unsealer
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      containers:
        - name: unsealer
          image: quay.io/openbao/openbao:2.6.1
          imagePullPolicy: IfNotPresent
          env:
            - name: BAO_ADDR
              value: http://openbao.openbao.svc.cluster.local:8200
            - name: INTERVAL
              value: "15"
          command:
            - /bin/sh
            - -c
            - |
              # `bao status` exits 0 when open, 2 when sealed, 1 when it is not
              # initialised or cannot be reached. Only 2 is this loop's
              # business: unsealing an uninitialised vault is impossible, and
              # an unreachable one is a problem no key will fix.
              while true; do
                bao status >/dev/null 2>&1
                rc=$?
                if [ "$rc" -eq 2 ]; then
                  echo "vault is sealed, applying key shares"
                  for f in /unseal-keys/key*; do
                    bao operator unseal "$(cat "$f")" >/dev/null 2>&1 || true
                  done
                  bao status >/dev/null 2>&1 && echo "vault unsealed"
                fi
                sleep "${INTERVAL}"
              done
          volumeMounts:
            - name: keys
              mountPath: /unseal-keys
              readOnly: true
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
      volumes:
        - name: keys
          secret:
            secretName: openbao-unseal-keys
