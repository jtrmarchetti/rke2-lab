{{ ansible_managed | comment }}
# The domain CA, as the Secret `certSecretRef` insists on.
#
# Public material, so it is committed in the clear rather than sealed — but it
# is not pasted in the clear. The bytes are read from the controller's trust
# store at render time, which is the same file `controller_trust` installed from
# the artifact host, so a rebuild that issues a new domain CA produces a new
# Secret here without anyone remembering to re-copy it.
---
apiVersion: v1
kind: Secret
metadata:
  name: gitlab-registry-ca
  namespace: flux-system
data:
  ca.crt: >-
    {{ lookup('file', gitops_source_domain_ca_file,
              rstrip=false) | b64encode }}
