{{ ansible_managed | comment }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: longhorn-system
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: longhorn
  namespace: longhorn-system
spec:
  interval: 30m
  timeout: 30m
  driftDetection:
    mode: warn
  chart:
    spec:
      chart: longhorn
      version: 1.12.1
      sourceRef:
        kind: HelmRepository
        name: gitlab-charts
        namespace: flux-system
  install:
    crds: Create
    remediation:
      retries: 2
  upgrade:
    crds: CreateReplace
    remediation:
      retries: 2
  values:
    defaultSettings:
      defaultDataPath: /var/lib/longhorn
      createDefaultDiskLabeledNodes: false
      defaultReplicaCount: 2
      storageOverProvisioningPercentage: 100
      storageMinimalAvailablePercentage: 15
      concurrentReplicaRebuildPerNodeLimit: 1
      concurrentAutomaticEngineUpgradePerNodeLimit: 1
      nodeDownPodDeletionPolicy: delete-both-statefulset-and-deployment-pod
      replicaReplenishmentWaitInterval: 1800
      backupTarget: ""
    persistence:
      defaultClass: true
      defaultClassReplicaCount: 2
      defaultFsType: ext4
      reclaimPolicy: Delete
    longhornManager:
      tolerations: []
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
    longhornDriver:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
    longhornUI:
      replicas: 1
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
    ingress:
      enabled: false
