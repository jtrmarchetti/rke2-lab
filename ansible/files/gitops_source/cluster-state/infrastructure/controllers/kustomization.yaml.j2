{{ ansible_managed | comment }}
---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  # Phase 6a. First in and, for now, alone: everything the secrets model does
  # later needs a controller that can decrypt what is committed to Git.
  - sealed-secrets
  # Phase 6b. The chart source everything below is installed from. Its pull
  # credential is a SealedSecret, which is why it comes after the controller
  # that decrypts it rather than beside it.
  - registry
  - cert-manager
  # LoadBalancer addresses, then the DNS that publishes them. The DNS Service
  # asks for a specific address, so it needs the pool to exist first — Flux
  # applies this directory as one set and retries, so the ordering is a
  # convenience here rather than a guarantee.
  - kube-vip-lb
  - cluster-dns
  - longhorn
  # Storage before the vault, because the vault's Raft store is a PVC.
  - openbao
  - external-secrets
