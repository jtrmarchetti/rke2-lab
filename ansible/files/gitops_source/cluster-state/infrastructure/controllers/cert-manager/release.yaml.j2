{{ ansible_managed | comment }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: cert-manager
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: cert-manager
  namespace: cert-manager
spec:
  interval: 30m
  timeout: 10m
  driftDetection:
    mode: warn
  chart:
    spec:
      chart: cert-manager
      version: v1.21.1
      sourceRef:
        kind: HelmRepository
        name: gitlab-charts
        namespace: flux-system
  install:
    crds: Create
    remediation:
      retries: 3
  upgrade:
    crds: CreateReplace
    remediation:
      retries: 3
  values:
    crds:
      enabled: true
    # Enable cert-manager's Gateway API shim so it watches the platform
    # Gateway's inline listeners and issues certs into the pre-declared
    # tls.certificateRefs secrets (driven by the cert-manager.io/cluster-issuer
    # annotation on the Gateway). Top-level extraArgs apply to the controller
    # container only. The ExperimentalGatewayAPISupport gate is Beta and
    # default-true, so only the flag needs to be set.
    extraArgs:
      - --enable-gateway-api
    resources:
      requests:
        cpu: 10m
        memory: 64Mi
      limits:
        memory: 192Mi
    webhook:
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          memory: 128Mi
    cainjector:
      resources:
        requests:
          cpu: 10m
          memory: 96Mi
        limits:
          memory: 256Mi
    startupapicheck:
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          memory: 128Mi
