{{ ansible_managed | comment }}
# The cluster's own authoritative DNS, for the cluster's own subdomain.
#
# k8s.dev.lo belongs to the cluster. FreeIPA forwards the whole zone here and
# holds no records for anything inside it, which is the point: names under this
# subdomain are created and destroyed by what is declared in this repository,
# and a name that GitOps manages should not need a second, manual step in the
# domain to exist.
#
# Two kinds of name are answered, and the split is what keeps the Corefile
# short:
#
#   <service>.<namespace>.k8s.dev.lo   every LoadBalancer Service, by k8s_external
#   <anything>.k8s.dev.lo              the ingress address, by template
#
# The template's pattern deliberately matches one label only, so it cannot
# shadow the two-label service names. That ordering matters because CoreDNS
# runs plugins in its own fixed order — template before k8s_external — not in
# the order they appear here.
#
# This is a second CoreDNS beside the cluster's own. It could have been the
# same one: RKE2's CoreDNS is configurable and would serve this zone happily.
# Keeping them apart means an external query storm cannot take cluster DNS with
# it, and that reconfiguring the cluster's subdomain never touches the resolver
# every pod depends on.
#
# The image is the one RKE2 already runs, so it is already mirrored and already
# on every node.
---
apiVersion: v1
kind: Namespace
metadata:
  name: cluster-dns
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cluster-dns
  namespace: cluster-dns
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: system:cluster-dns
rules:
  - apiGroups: [""]
    resources: ["endpoints", "services", "pods", "namespaces"]
    verbs: ["list", "watch"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: system:cluster-dns
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:cluster-dns
subjects:
  - kind: ServiceAccount
    name: cluster-dns
    namespace: cluster-dns
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-dns
  namespace: cluster-dns
data:
  Corefile: |
    {{ gitops_source_cluster_domain }}:5353 {
        errors
        health :8080
        ready :8181
        # k8s_external needs the kubernetes plugin present to reach the API,
        # but this server answers nothing in cluster.local: the zone above is
        # the only one it is authoritative for.
        kubernetes cluster.local
        k8s_external {{ gitops_source_cluster_domain }}
        template IN A {{ gitops_source_cluster_domain }} {
            match "^[^.]+\.{{ gitops_source_cluster_domain | replace('.', '\\.') }}\.$"
            answer "{% raw %}{{ .Name }}{% endraw %} 60 IN A {{ gitops_source_ingress_address }}"
            fallthrough
        }
        template IN AAAA {{ gitops_source_cluster_domain }} {
            match "^[^.]+\.{{ gitops_source_cluster_domain | replace('.', '\\.') }}\.$"
            rcode NOERROR
        }
        cache 30
        loop
        reload
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cluster-dns
  namespace: cluster-dns
spec:
  # Two, because a single replica means the cluster's whole subdomain stops
  # resolving during a rolling update or a node drain. They are cheap.
  replicas: 2
  selector:
    matchLabels:
      app: cluster-dns
  template:
    metadata:
      labels:
        app: cluster-dns
    spec:
      serviceAccountName: cluster-dns
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: cluster-dns
      containers:
        - name: coredns
          image: rancher/hardened-coredns:v1.14.6-build20260722
          imagePullPolicy: IfNotPresent
          args:
            - -conf
            - /etc/coredns/Corefile
          ports:
            # Unprivileged: the LoadBalancer Service maps 53 to this, so
            # nothing here needs NET_BIND_SERVICE.
            - containerPort: 5353
              name: dns
              protocol: UDP
            - containerPort: 5353
              name: dns-tcp
              protocol: TCP
          resources:
            requests:
              cpu: 25m
              memory: 64Mi
            limits:
              memory: 170Mi
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 30
          readinessProbe:
            httpGet:
              path: /ready
              port: 8181
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - name: config
              mountPath: /etc/coredns
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: cluster-dns
---
apiVersion: v1
kind: Service
metadata:
  name: cluster-dns
  namespace: cluster-dns
  annotations:
    # Requested rather than allocated. FreeIPA's forward zone names this
    # address, and a forwarder that has to be edited every time the cluster
    # reschedules a pod is not a forwarder anyone would keep.
    kube-vip.io/loadbalancerIPs: {{ gitops_source_dns_address }}
spec:
  type: LoadBalancer
  # Local, so the answering node is one actually running a replica and the
  # client address survives — kube-vip announces from a node with an endpoint.
  externalTrafficPolicy: Local
  selector:
    app: cluster-dns
  ports:
    - name: dns
      port: 53
      targetPort: 5353
      protocol: UDP
    - name: dns-tcp
      port: 53
      targetPort: 5353
      protocol: TCP
