{{ ansible_managed | comment }}

token: {{ inventory_rke2_server_token }}
{# The join-pin marker written by the etcd_rejoin heal pins this node
   into the cluster join path on every re-render: a healed bootstrap
   node keeps the server address, or a wiped store restarts into
   new-cluster mode and fatals again. Unhealed join nodes render the
   canonical virtual-address line. #}
{% if (not (rke2_server_bootstrap | bool))
      or (_rke2_server_join_pin | length > 0) %}

server: {{ _rke2_server_join_pin
          if (_rke2_server_join_pin | length > 0)
          else ('https://' ~ inventory_rke2_server_api_address
                ~ ':' ~ (inventory_rke2_server_supervisor_port | string)) }}
{% else %}

{% endif %}

node-ip: {{ inventory_rke2_server_node_ip }}

tls-san:
{% for _item_rke2_server_san in inventory_rke2_server_tls_san %}
  - {{ _item_rke2_server_san }}
{% endfor %}

cni: {{ inventory_rke2_server_cni }}

data-dir: {{ inventory_rke2_server_data_dir }}

{% if inventory_rke2_server_disable | length > 0 %}
disable:
{% for _item_rke2_server_component in inventory_rke2_server_disable %}
  - {{ _item_rke2_server_component }}
{% endfor %}
{% endif %}

{% if inventory_rke2_server_ingress_controller | length > 0 %}

ingress-controller:
{% for _item_rke2_server_controller in inventory_rke2_server_ingress_controller %}
  - {{ _item_rke2_server_controller }}
{% endfor %}
{% endif %}

{% if inventory_rke2_server_node_taints | length > 0 %}

node-taint:
{% for _item_rke2_server_taint in inventory_rke2_server_node_taints %}
  - {{ _item_rke2_server_taint }}
{% endfor %}
{% endif %}

disable-default-registry-endpoint: true

etcd-snapshot-schedule-cron: "{{ inventory_rke2_server_etcd_snapshot_schedule }}"
etcd-snapshot-retention: {{ inventory_rke2_server_etcd_snapshot_retention }}

{% if inventory_rke2_server_etcd_args | length > 0 %}

etcd-arg:
{% for _item_rke2_server_etcd_arg in inventory_rke2_server_etcd_args %}
  - {{ _item_rke2_server_etcd_arg }}
{% endfor %}
{% endif %}

{% if inventory_rke2_server_expose_metrics | bool %}

etcd-expose-metrics: true

kube-controller-manager-arg:
  - bind-address=0.0.0.0

kube-scheduler-arg:
  - bind-address=0.0.0.0

kube-proxy-arg:
  - metrics-bind-address=0.0.0.0

{% endif %}

write-kubeconfig-mode: "0600"
