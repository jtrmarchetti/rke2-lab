{{ ansible_managed | comment }}

---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-traefik
  namespace: kube-system
spec:
  valuesContent: |-

    nodeSelector:
      {{ inventory_rke2_server_ingress_node_selector }}: "true"

    service:
      spec:
        type: LoadBalancer
      annotations:
        kube-vip.io/loadbalancerIPs: "{{ inventory_rke2_server_ingress_address }}"
