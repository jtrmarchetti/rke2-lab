---

# Rendered by the rke2_server role into /data1/rancher/rke2/server/manifests/.
# This is a Kubernetes Secret, not a Helm object: RKE2 applies it to the API
# at boot, before the rke2-cilium helm-controller Job runs, so the encrypted
# Cilium agent already has its keys when the IPsec datapath starts.
#
# The value is cluster key material generated once on the controller and
# recorded in ~/.config/rke2lab/env.sh (CILIUM_IPSEC_KEYS), the same channel
# RKE2_TOKEN uses to reach every node. It is deliberately NOT committed to the
# cluster-state GitLab repository: a PSK in GitLab would let anyone who can
# read the repo decrypt every east-west packet. Rotating the key = rotate
# CILIUM_IPSEC_KEYS and re-render; keyWatcher makes the agent pick it up
# without a manual restart.
#
# Line format (one key, rfc4106-gcm-aes / AES-GCM-128):
#   <key-id>+ rfc4106(gcm(aes)) <80-hex-chars PSK> 128
# The leading "+" forces per-tunnel (per-node-pair) derived keys rather than
# the deprecated global-key mode (GHSA-pwqm-x5x6-5586). key-id 1 is a fresh
# cluster; rotation increments it.

apiVersion: v1
kind: Secret
metadata:
  name: cilium-ipsec-keys
  namespace: kube-system
type: Opaque
stringData:
  keys: "{{ rke2_server_cilium_ipsec_keys }}"
