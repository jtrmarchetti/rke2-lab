#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}
# The jinja2 directive above must stay on line 1 to take effect.
# Sourced by docker compose. Values originate from ~/.config/rke2lab/env.sh on the
# controller and are never stored in the project repository.
#
# Every `$` is doubled. Compose interpolates the values in this file, so a raw
# `$` starts a variable reference: a password of `aa$Fls3bb` reaches the
# container as `aa`, and FreeIPA then installs with a password nobody can
# reproduce. `$$` is compose's escape for a literal `$`.
FREEIPA_ADMIN_PASSWORD={{ freeipa_server_admin_password | replace('$', '$$') }}
FREEIPA_DIR_MANAGER_PASSWORD={{ freeipa_server_directory_manager_password | replace('$', '$$') }}
