[Interface]
Address = {{ controller_tunnel_address }}
ListenPort = {{ controller_tunnel_listen_port }}
PrivateKey = {{ controller_tunnel_private_key | trim }}
{% for _item_controller_tunnel_subnet in controller_tunnel_route_subnets %}
PostUp = ip route replace {{ _item_controller_tunnel_subnet }} dev {{ controller_tunnel_interface }}
PostDown = ip route del {{ _item_controller_tunnel_subnet }} dev {{ controller_tunnel_interface }} || true
{% endfor %}

[Peer]
PublicKey = {{ controller_tunnel_gateway_public_key }}
AllowedIPs = {{ controller_tunnel_peer_allowed_ips | join(',') }}
Endpoint = {{ controller_tunnel_peer_endpoint }}
PersistentKeepalive = {{ controller_tunnel_peer_persistent_keepalive }}
